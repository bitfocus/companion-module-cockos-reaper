{
	"name": "cockos-reaper",
	"version": "2.5.0",
	"main": "dist/index.js",
	"scripts": {
		"prepare": "husky install",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"test": "node --test test/custom-feedback.test.mjs"
	},
	"license": "MIT",
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"dependencies": {
		"@companion-module/base": "~1.15.0",
		"reaper-osc": "0.5.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.9.0",
		"@types/node": "^18.11.9",
		"husky": "^8.0.1",
		"lint-staged": "^13.0.3",
		"rimraf": "^3.0.2",
		"typescript": "~5.9.3",
		"eslint": "^9.39.3",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.56.0"
	},
	"engines": {
		"node": "^26.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-cockos-reaper.git"
	}
}
